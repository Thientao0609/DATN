// Prisma schema — website đặt lịch khám bệnh tích hợp AI Agent.
// Mọi thời gian lưu dạng UTC (DATETIME(3)); hiển thị và tính khung giờ theo Asia/Ho_Chi_Minh.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CreatedVia {
  FORM
  CHATBOT
}

enum ChatRole {
  user
  assistant
  tool
}

enum PendingActionType {
  CREATE
  RESCHEDULE
  CANCEL
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor         Doctor?
  appointments   Appointment[]
  chatSessions   ChatSession[]
  pendingActions PendingAction[]

  @@map("users")
}

model Specialty {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String   @db.Text
  // Các triệu chứng thường gặp, agent dùng để gợi ý khoa.
  symptomHints String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctors Doctor[]

  @@map("specialties")
}

model Doctor {
  id          String   @id @default(cuid())
  userId      String   @unique
  specialtyId String
  bio         String   @db.Text
  // Phí khám, đơn vị VND.
  fee         Int
  slotMinutes Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  specialty    Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  schedules    WorkingSchedule[]
  appointments Appointment[]

  @@index([specialtyId])
  @@map("doctors")
}

model WorkingSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  // 0 = Chủ nhật ... 6 = Thứ bảy
  dayOfWeek Int
  // "HH:mm" theo giờ Việt Nam
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, dayOfWeek])
  @@map("working_schedules")
}

model Appointment {
  id         String            @id @default(cuid())
  patientId  String
  doctorId   String
  startTime  DateTime
  endTime    DateTime
  reason     String            @db.Text
  status     AppointmentStatus @default(CONFIRMED)
  createdVia CreatedVia        @default(FORM)
  // 1 khi lịch còn hiệu lực (CONFIRMED, COMPLETED), null khi CANCELLED.
  // Unique index cho phép nhiều giá trị null nên lịch đã hủy không chặn lịch mới.
  // Chỉ service được ghi cột này.
  activeKey  Int?              @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  patient User   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([doctorId, startTime, activeKey])
  @@index([patientId, startTime])
  @@map("appointments")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  pendingActions PendingAction[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       ChatRole
  content    String   @db.Text
  toolCalls  Json?
  toolCallId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model PendingAction {
  id        String              @id @default(cuid())
  sessionId String
  userId    String
  type      PendingActionType
  payload   Json
  status    PendingActionStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("pending_actions")
}

model ClinicInfo {
  id        String   @id @default(cuid())
  topic     String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinic_info")
}
