# # Chuỗi kết nối MySQL (database sẽ được Prisma tạo nếu chưa có)
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/clinic_booking"
# # Khóa ký JWT, tối thiểu 32 ký tự
# JWT_SECRET="replace-with-a-random-string-at-least-32-chars"
# # Cổng backend
# PORT=4000
# # Origin của frontend được phép CORS (nhiều origin cách nhau bằng dấu phẩy)
# FRONTEND_ORIGIN="http://localhost:5173"
# # 9Router (chuẩn OpenAI) — do bạn cung cấp
# LLM_BASE_URL=""
# LLM_API_KEY=""
# # Tên model, phải hỗ trợ tool calling
# LLM_MODEL=""
# # Tên phòng khám chèn vào system prompt
# CLINIC_NAME="Phòng khám Đa khoa An Tâm"
# # Gửi email thông báo (không bắt buộc). Để trống SMTP_HOST thì email được lưu thành file .eml trong backend/outbox/
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# # Địa chỉ người gửi, ví dụ "Phòng khám An Tâm <no-reply@example.com>"
# MAIL_FROM=""

# Kết nối MySQL
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/clinic_booking"

# JWT Secret - tối thiểu 32 ký tự
JWT_SECRET="ClinicBooking_2026_ThienApple_SecureKey_123456"

# Backend
PORT=4000

# Frontend
FRONTEND_ORIGIN="http://localhost:5173"

# Cấu hình AI - bổ sung sau
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Tên phòng khám
CLINIC_NAME="Phòng khám Đa khoa An Tâm"

# Email - chưa cần cấu hình
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
